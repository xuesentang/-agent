MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat
MODEL_API_KEY=replace-me
STRUCTURED_OUTPUT_METHOD=json_mode
# 输入加输出的近似总预算；输出固定预留 512 token
HISTORY_TOKEN_BUDGET=4000
# 本机 MySQL80（3306）；将用户名和密码填入本机 .env，密码特殊字符需 URL 编码
DATABASE_URL=mysql+pymysql://YOUR_USER:URL_ENCODED_PASSWORD@127.0.0.1:3306/customer_service?charset=utf8mb4

# 第三章：Zilliz Cloud Free 集群（仅填在本机 .env，不要提交）
MILVUS_URI=
MILVUS_TOKEN=
# Hugging Face 下载不稳定时，可指定已经下载好的 BGE-M3 本地目录
BGE_M3_MODEL_PATH=
