# 上游:DeepSeek 官方(OpenAI 兼容)。模型名就用 deepseek-flash,
# 即 DeepSeek-V4.1-Flash;非思考模型,同样的正文比思考模型省六到七成 token。
# 换别家只改这三行:BASE_URL / API_KEY / MODEL。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# DeepSeek 思考模式默认开启,关掉才快(disabled 关 / enabled 开 / 留空则不发该参数)。
# 思考 + tools 时上一轮 reasoning_content 必须回传,本项目工具循环没做,故默认关。
LLM_THINKING=disabled
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=512
LLM_TIMEOUT=60
LLM_MAX_RETRIES=1
LLM_STRUCTURED_METHOD=json_mode
HISTORY_TOKEN_BUDGET=2048

# CH02 database (Docker MySQL, host port 3307)
DATABASE_URL=mysql+aiomysql://root:root@127.0.0.1:3307/kefu_agent
MYSQL_ROOT_PASSWORD=
DB_ECHO=false
TOOL_TIMEOUT_SECONDS=10.0

# CH03 RAG: 向量库。开发默认 Milvus Lite(pip 嵌入式文件库,零 Docker 依赖);
# 切 Milvus 服务端时改成 http://127.0.0.1:19530(pymilvus 同一套 API,代码不动)。
# 变量名不能叫 MILVUS_URI——pymilvus 内部就读这个名字,import 时会崩(见 dev-notes/ch03.md)。
VECTOR_STORE_URI=./data/milvus_lite.db
# 本地模型目录(下载命令见 README「模型权重」节;hf 镜像拉取,~2.2G)
EMBEDDING_MODEL=D:/客服agent/models/bge-m3

# CH04 RAG 进阶: 重排模型(本地目录或 HF 名;不配则用 BAAI/bge-reranker-v2-m3)
RERANK_MODEL=D:/客服agent/models/bge-reranker-v2-m3
# 生成前的证据自评闸(LLM 判证据够不够答);关掉只按「零命中」拒答
EVIDENCE_SELFCHECK_ENABLED=true
# 混合检索两路各召回多少条进 RRF。库涨到几百块后 50 等于扫 10%,评估会重新变成
# 「大范围扫描」;按库规模配,350 块量级用 20(约 4%-6%)。
RECALL_ROUTE_LIMIT=20

# CH04 评测: 裁判模型。留空 = 回落 LLM_MODEL(报告会标注「裁判=生成」,分数只能横向比)。
# 想让 Faithfulness / 覆盖度的绝对分数可信,必须填一个与 LLM_MODEL 不同的模型,
# 最好不同厂商;跨厂商时同时填 JUDGE_BASE_URL 与 JUDGE_API_KEY。
JUDGE_MODEL=
JUDGE_BASE_URL=
JUDGE_API_KEY=

# CH05 工作流:知识类置信度闸的分数粗筛线(dense 相似度),与主力 Agent 的停止条件
KB_MIN_SCORE=0.45
AGENT_MAX_STEPS=4
AGENT_TOKEN_BUDGET=6000

# CH07 上下文管理:预算从窗口倒推,不写死历史长度。这五项都是倒推公式的输入,
# 改任何一个都会改变层 1 / 层 2 的预算。演示级联降级时用:
#   MODEL_CONTEXT_WINDOW=18000 MAX_OUTPUT_TOKENS=2000 MAX_USER_INPUT_TOKENS=2000
#   AGENT_MAX_STEPS=3 TOOL_RESULT_MAX_TOKENS=1200 RERANK_TOP_K=5
MODEL_CONTEXT_WINDOW=65536
MAX_OUTPUT_TOKENS=2000
MAX_USER_INPUT_TOKENS=2000
TOOL_RESULT_MAX_TOKENS=1200
RERANK_TOP_K=5
# 层 2 里客服答复只留开头这么多字(用户原话不动,工具结果换成一行标识)
LAYER2_ASSISTANT_HEAD=40
# 后台摘要:层 2 攒到超预算才压;失败不影响当轮回复
CONTEXT_SUMMARY_ENABLED=true
CONTEXT_SUMMARY_TIMEOUT=60

# 日志级别;agent.trace / model_ctx / history_ctx 靠它出得来
LOG_LEVEL=INFO

# CH08 工具系统:MCP 接入。
# 打开后内置 query_logistics 下线,物流查询交给物流 MCP Server(不留重名工具)
MCP_ENABLED=false
MCP_SERVERS=logistics=http://127.0.0.1:8121/mcp,aftersale=http://127.0.0.1:8122/mcp
# 工具清单缓存时长(秒):Server 侧加了工具,最多等这么久就能拉到,客服服务不用重启
MCP_TOOL_TTL_SECONDS=30
# MCP 调用超时(秒)
MCP_TIMEOUT_SECONDS=20.0

# CH09 可观测性:Langfuse trace(Langfuse Cloud 免费层,或按
# docker-compose.langfuse.yml 自托管)。默认关闭;enabled=true 且 key 齐全、
# host 可达时才上报,任一不满足都静默跳过——聊天链路零感知
# (四种降级路径见 app/observability/tracing.py)
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 美区账号(us.cloud.langfuse.com)按 SDK 文档习惯写成 LANGFUSE_BASE_URL,
# 两个名字都认,写哪个都行
LANGFUSE_HOST=https://cloud.langfuse.com
